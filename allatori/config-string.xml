<config>
    <input>
        <jar in="../target/app-original.jar" out="../target/app-string.jar"/>
    </input>

    <!-- Reprodutibilidade: mesma seed em todas as execucoes -->
    <property name="random-seed" value="finance-perf-2026"/>
    <!-- Mapa ofuscado->original (restauracao de stack trace / analise) -->
    <property name="log-file" value="../target/allatori-log-string.xml"/>

    <!-- Perfil STRING: renaming + string encryption (control flow DESLIGADO). -->
    <property name="control-flow-obfuscation" value="disable"/>
    <!-- String encryption desligada globalmente e no maximo apenas no motor. -->
    <property name="string-encryption" value="disable"/>
    <property name="string-encryption" value="maximum" apply2class="class com.finance.engine.*"/>

    <keep-names>
        <!-- Renomeia SOMENTE o motor (com.finance.engine.*). Todo o resto
             (harness JMH, OrderFactory e libs de terceiros referenciadas
             pelas classes JMH ignoradas) mantem classe, campos e metodos. -->
        <class template="not class com.finance.engine.*">
            <field template="*"/>
            <method template="*(**)"/>
        </class>

        <!-- Entry point de correcao: preserva a classe e o main() -->
        <class template="class com.finance.engine.CorrectnessRunner">
            <method template="* main(**)"/>
        </class>

        <!-- Modelo de dados publico usado pela OrderFactory: mantem os campos -->
        <class template="class com.finance.engine.TransactionEngine$Order">
            <field template="*"/>
        </class>
    </keep-names>

    <!-- JMH copiado sem alteracoes (usa reflection intensivamente) -->
    <ignore-classes>
        <class template="class org.openjdk.jmh.*"/>
    </ignore-classes>
</config>