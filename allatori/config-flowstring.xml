<config>
    <!-- Entrada e app-strenc.jar (nao app-original.jar): a criptografia de
         strings deste perfil e feita ANTES pelo ZKM (zkm/config-stringenc.zkm,
         rodado por scripts/02_obfuscate.sh), porque a edicao Educational do
         Allatori ignora silenciosamente string-encryption (ver ZKM_log / T7
         para o diagnostico). Aqui o Allatori aplica renaming + control flow
         em cima do jar ja com as strings do motor criptografadas. -->
    <input>
        <jar in="../target/app-strenc.jar" out="../target/app-flowstring.jar"/>
    </input>

    <!-- Reprodutibilidade: mesma seed em todas as execucoes -->
    <property name="random-seed" value="finance-perf-2026"/>
    <!-- Mapa ofuscado->original (restauracao de stack trace / analise) -->
    <property name="log-file" value="../target/allatori-log-flowstring.xml"/>

    <!-- Perfil FLOWSTRING: renaming + control flow (+ string encryption feita
         pelo ZKM na entrada). Fator caro desligado globalmente e ligado
         apenas no motor. Nao ha property "string-encryption" aqui porque o
         Allatori Educational nao suporta esse recurso (seria um no-op
         enganoso deixa-lo declarado). -->
    <property name="control-flow-obfuscation" value="disable"/>
    <property name="control-flow-obfuscation" value="enable" apply2class="class com.finance.engine.*"/>
    <property name="extensive-flow-obfuscation" value="maximum" apply2class="class com.finance.engine.*"/>

    <keep-names>
        <!-- Renomeia SOMENTE o motor (com.finance.engine.*). Todo o resto
             (harness JMH, OrderFactory e libs de terceiros referenciadas
             pelas classes JMH ignoradas) mantem classe, campos e metodos. -->
        <class template="not class com.finance.engine.*">
            <field template="*"/>
            <method template="*(**)"/>
        </class>

        <!-- Entry point de correcao: preserva a classe e o main() -->
        <class template="class com.finance.engine.CorrectnessRunner">
            <method template="* main(**)"/>
        </class>

        <!-- Modelo de dados publico usado pela OrderFactory: mantem os campos -->
        <class template="class com.finance.engine.TransactionEngine$Order">
            <field template="*"/>
        </class>
    </keep-names>

    <!-- JMH copiado sem alteracoes (usa reflection intensivamente) -->
    <ignore-classes>
        <class template="class org.openjdk.jmh.*"/>
    </ignore-classes>
</config>