      "seed": 297975,
      "version": 6,
      "versionNonce": 1310132756,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785800180976,
      "link": null,
      "locked": false,
      "text": "- ci95() - media + IC95%, t de Student\n  (sobre medias por fork, nao iteracoes)\n\n- bootstrap_overhead_ci() - IC95% do overhead,\n  10.000 reamostragens da razao de medias\n\n- significance() - Shapiro-Wilk decide:\n  normal -> Welch-t | nao-normal -> Mann-Whitney U\n\n- cliffs_delta() - tamanho de efeito nao-parametrico\n\n- holm_bonferroni() - corrige os 4 perfis testados\n  como familia, por (arch, size)",
      "fontSize": 12.826666666666666,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "- ci95() - media + IC95%, t de Student\n  (sobre medias por fork, nao iteracoes)\n\n- bootstrap_overhead_ci() - IC95% do overhead,\n  10.000 reamostragens da razao de medias\n\n- significance() - Shapiro-Wilk decide:\n  normal -> Welch-t | nao-normal -> Mann-Whitney U\n\n- cliffs_delta() - tamanho de efeito nao-parametrico\n\n- holm_bonferroni() - corrige os 4 perfis testados\n  como familia, por (arch, size)",
      "lineHeight": 1.25,
      "index": "aC",
      "autoResize": true
    },
