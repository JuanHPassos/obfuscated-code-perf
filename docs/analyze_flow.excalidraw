    {
      "id": "text13",
      "type": "text",
      "x": 90,
      "y": 452,
      "width": 340.26666259765625,
      "height": 208.4333333333333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
